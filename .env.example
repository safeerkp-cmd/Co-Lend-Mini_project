# Co-Lend Smart Resident Ledger - Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the actual '.env' file containing real secrets to version control.

# Flask Application Secret Key (e.g. generated via python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secure_random_secret_key_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=colend_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Runtime Environment Configuration
FLASK_DEBUG=false
